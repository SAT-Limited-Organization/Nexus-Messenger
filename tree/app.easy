                                "_type": "String",
                                "value_": "easy.intent.putExtra(\"ref\",ref)"
                            }
                        },
                        {
                            "_id_": 217,
                            "_type": "Activity.PickImage",
                            "showChooser": {
                                "_id_": 218,
                                "_type": "Boolean",
                                "value_": true
                            },
                            "onResult": {
                                "_id_": 219,
                                "_type": "Sequence",
                                "list_": [
                                    {
                                        "_id_": 220,
                                        "_type": "LocalVariable",
                                        "init": {
                                            "_id_": 221,
                                            "_type": "Bitmap.MakeThumbnail",
                                            "image": {
                                                "_id_": 222,
                                                "_type": "LocalVariable.Get",
                                                "name": {
                                                    "_id_": 223,
                                                    "_type": "String",
                                                    "value_": "data"
                                                },
                                                "comment": {
                                                    "_id_": 224,
                                                    "_type": "Comment",
                                                    "list_": [],
                                                    "text_": "Provided by Activity.PickImage node."
                                                }
                                            },
                                            "width": {
                                                "_id_": 225,
                                                "_type": "Integer",
                                                "value_": 48
                                            },
                                            "comment": {
                                                "_id_": 226,
                                                "_type": "Comment",
                                                "list_": [],
                                                "text_": "Convert the image to a thumbnail 48x48 pixels."
                                            },
                                            "height": {
                                                "_id_": 227,
                                                "_type": "Integer",
                                                "value_": 48
                                            }
                                        },
                                        "name": {
                                            "_id_": 228,
                                            "_type": "String",
                                            "value_": "image"
                                        }
                                    },
                                    {
                                        "_id_": 229,
                                        "_type": "Firebase.Database.SetValue",
                                        "ref": {
                                            "_id_": 230,
                                            "_type": "Intent.Extra",
                                            "name": {
                                                "_id_": 231,
                                                "_type": "String",
                                                "value_": "ref"
                                            },
                                            "comment": {
                                                "_id_": 232,
                                                "_type": "Comment",
                                                "list_": [],
                                                "text_": "Retrieve the database reference from the intent. Note that we do not use the 'ref' argument here because onResult may be executed after an activity restart."
                                            }
                                        },
                                        "value": {
                                            "_id_": 233,
                                            "_type": "Bitmap.Compress",
                                            "image": {
