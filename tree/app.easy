            {
                "_id_": 155,
                "_type": "Function",
                "name": {
                    "_id_": 156,
                    "_type": "String",
                    "value_": "timeToLabel"
                },
                "comment": {
                    "_id_": 157,
                    "_type": "Comment",
                    "list_": [],
                    "text_": "Convert time value to a text like '5 hours ago'"
                },
                "body": {
                    "_id_": 158,
                    "_type": "Sequence",
                    "list_": [
                        {
                            "_id_": 159,
                            "_type": "Argument",
                            "name": {
                                "_id_": 160,
                                "_type": "String",
                                "value_": "time"
                            }
                        },
                        {
                            "_id_": 161,
                            "_type": "LocalVariable",
                            "init": {
                                "_id_": 162,
                                "_type": "CurrentTime"
                            },
                            "name": {
                                "_id_": 163,
                                "_type": "String",
                                "value_": "currentTime"
                            }
                        },
                        {
                            "_id_": 164,
                            "_type": "LocalVariable",
                            "init": {
                                "_id_": 165,
                                "_type": "String.Text",
                                "value": {
                                    "_id_": 166,
                                    "_type": "String",
                                    "value_": "min"
                                }
                            },
                            "name": {
                                "_id_": 167,
                                "_type": "String",
                                "value_": "text"
                            }
                        },
                        {
                            "_id_": 168,
                            "_type": "LocalVariable.Set",
                            "name": {
                                "_id_": 169,
                                "_type": "String",
                                "value_": "time"
                            },
                            "value": {
                                "_id_": 170,
                                "_type": "Expression",
                                "comment": {
                                    "_id_": 171,
                                    "_type": "Comment",
                                    "list_": [],
                                    "text_": "How many minutes ago?\n"
                                },
                                "text": {
                                    "_id_": 172,
                                    "_type": "String",
                                    "value_": "(currentTime-time)\/60000"
                                }
                            }
                        },
                        {
                            "_id_": 173,
                            "_type": "Conditional",
                            "condition": {
                                "_id_": 174,
                                "_type": "Expression",
                                "comment": {
                                    "_id_": 175,
                                    "_type": "Comment",
                                    "list_": [],
                                    "text_": "Is it less than 1 hour?"
                                },
                                "text": {
                                    "_id_": 176,
                                    "_type": "String",
                                    "value_": "time<60"
                                }
                            },
                            "onTrue": {
                                "_id_": 177,
                                "_type": "LocalVariable.Set",
                                "name": {
                                    "_id_": 178,
                                    "_type": "String",
                                    "value_": "text"
                                },
                                "value": {
                                    "_id_": 179,
                                    "_type": "String.Text",
                                    "value": {
                                        "_id_": 180,
                                        "_type": "String",
                                        "value_": "min"
                                    }
                                }
                            },
                            "onFalse": {
                                "_id_": 181,
                                "_type": "Sequence",
                                "list_": [
                                    {
                                        "_id_": 182,
                                        "_type": "LocalVariable.Set",
                                        "name": {
                                            "_id_": 183,
                                            "_type": "String",
                                            "value_": "time"
                                        },
                                        "value": {
                                            "_id_": 184,
                                            "_type": "Expression",
                                            "comment": {
                                                "_id_": 185,
                                                "_type": "Comment",
                                                "list_": [],
                                                "text_": "How many hours ago?\n"
                                            },
                                            "text": {
                                                "_id_": 186,
                                                "_type": "String",
                                                "value_": "time\/60"
                                            }
                                        }
                                    },
                                    {
                                        "_id_": 187,
                                        "_type": "Conditional",
                                        "condition": {
                                            "_id_": 188,
                                            "_type": "Expression",
                                            "text": {
                                                "_id_": 189,
                                                "_type": "String",
                                                "value_": "time<24"
                                            }
                                        },
                                        "onTrue": {
                                            "_id_": 190,
                                            "_type": "LocalVariable.Set",
                                            "name": {
                                                "_id_": 191,
                                                "_type": "String",
                                                "value_": "text"
                                            },
                                            "value": {
                                                "_id_": 192,
                                                "_type": "String.Text",
                                                "value": {
                                                    "_id_": 193,
                                                    "_type": "String",
                                                    "value_": "hours"
                                                }
                                            }
                                        },
                                        "onFalse": {
                                            "_id_": 194,
                                            "_type": "Sequence",
                                            "list_": [
                                                {
                                                    "_id_": 195,
                                                    "_type": "LocalVariable.Set",
                                                    "name": {
                                                        "_id_": 196,
                                                        "_type": "String",
                                                        "value_": "time"
                                                    },
                                                    "value": {
                                                        "_id_": 197,
                                                        "_type": "Expression",
                                                        "comment": {
                                                            "_id_": 198,
                                                            "_type": "Comment",
                                                            "list_": [],
                                                            "text_": "How many days ago?\n"
                                                        },
                                                        "text": {
                                                            "_id_": 199,
